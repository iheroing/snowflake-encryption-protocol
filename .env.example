# Vercel Marketplace injects these names automatically.
KV_REST_API_URL=https://your-database.upstash.io
KV_REST_API_TOKEN=replace-with-upstash-rest-token

# A directly managed Upstash database may use these names instead:
# UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
# UPSTASH_REDIS_REST_TOKEN=replace-with-upstash-rest-token

# Generate an independent high-entropy value, e.g. `openssl rand -base64 32`.
# It salts the one-way IP identifiers used only for rate limiting.
RATE_LIMIT_SALT=replace-with-random-rate-limit-salt
